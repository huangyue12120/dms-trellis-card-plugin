{
    "id": "trellisDms",
    "name": "Trellis DMS",
    "description": "Read-only Trellis project status for DankMaterialShell",
    "version": "0.9.0",
    "author": "Trellis DMS Contributors",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "desktop-widget", "launcher"],
    "components": {
        "daemon": "./TrellisDaemon.qml",
        "widget": "./TrellisWidget.qml",
        "desktop": "./TrellisDesktopWidget.qml",
        "launcher": "./TrellisLauncher.qml"
    },
    "trigger": "!trellis",
    "settings": "./TrellisSettings.qml",
    "requires_dms": ">=1.6.2",
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
